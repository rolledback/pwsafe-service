#!/bin/bash
set -e

# Configuration - Update these values for your local environment (paths should be relative to backend/)
CONFIG_DIR="./some/folder/config" # Path to config directory (contains settings.json)
DATA_DIR="./some/folder/data"     # Path to data directory (contains static/ and provider folders)

# On first start, visit the UI in your browser to choose a security mode.
# To skip setup for dev, add "auth": { "mode": "unsecured" } to your settings.json.

# This value usually does not need to be changed
STATIC_DIR="../frontend/dist"     # Path to frontend build output

echo "Building frontend..."
cd frontend && npm run build

echo "Building backend..."
cd ../backend && go build -o pwsafe-service cmd/pwsafe-service/main.go

echo "Stopping any running instance..."
pkill -f pwsafe-service || true

echo "Starting pwsafe-service..."
PWSAFE_CONFIG_DIR="$CONFIG_DIR" \
PWSAFE_DATA_DIR="$DATA_DIR" \
PWSAFE_STATIC_DIR="$STATIC_DIR" \
./pwsafe-service
